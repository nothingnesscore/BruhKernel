diff --git a/fs/susfs.c b/fs/susfs.c
index d88b00e..ae24af2 100644
--- a/fs/susfs.c
+++ b/fs/susfs.c
@@ -1466,3 +1466,130 @@ void susfs_init(void) {\
 /* No module exit is needed becuase it should never be a loadable kernel module */
 //void __init susfs_exit(void)
 
+
+#ifdef CONFIG_KSU_SUSFS_UNICODE_FILTER
+static bool has_suspicious_unicode(const char *path, long len)
+{
+	long i = 0;
+	while (i < len) {
+		unsigned char c = (unsigned char)path[i];
+		if (likely(c < 0x80)) {
+			i++;
+			continue;
+		}
+		if (c == 0xC2 && i + 1 < len && path[i+1] == (char)0xAD)
+			return true;
+		if (c == 0xCD && i + 1 < len && path[i+1] == (char)0x8F)
+			return true;
+		if (c == 0xD8 && i + 1 < len && path[i+1] == (char)0x9C)
+			return true;
+		if (c == 0xE2 && i + 2 < len) {
+			unsigned char c2 = (unsigned char)path[i+1];
+			unsigned char c3 = (unsigned char)path[i+2];
+			if (c2 == 0x80 && (c3 >= 0x8B && c3 <= 0x8F))
+				return true;
+			if (c2 == 0x80 && (c3 >= 0xAA && c3 <= 0xAE))
+				return true;
+			if (c2 == 0x81 && (c3 >= 0xA0 && c3 <= 0xAF))
+				return true;
+		}
+		if (c == 0xEF && i + 2 < len) {
+			unsigned char c2 = (unsigned char)path[i+1];
+			unsigned char c3 = (unsigned char)path[i+2];
+			if (c2 == 0xBB && c3 == 0xBF)
+				return true;
+			if (c2 == 0xBF && (c3 >= 0xB0 && c3 <= 0xBF))
+				return true;
+		}
+		i++;
+	}
+	return false;
+}
+
+bool susfs_check_unicode_bypass(const char *pathname)
+{
+	if (!pathname)
+		return false;
+	return has_suspicious_unicode(pathname, strlen(pathname));
+}
+#endif
+
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT_REDIRECT
+struct susfs_sus_kstat_redirect_hl_node {
+	char                                    virtual_pathname[SUSFS_MAX_LEN_PATHNAME];
+	unsigned long                           target_ino;
+	struct st_susfs_sus_kstat_redirect      info;
+	struct hlist_node                       node;
+	struct rcu_head                         rcu;
+};
+
+static DEFINE_HASHTABLE(sus_kstat_redirect_hashtable, 10);
+static DEFINE_SPINLOCK(susfs_kstat_redirect_lock);
+
+int susfs_add_sus_kstat_redirect(void __user *user_arg)
+{
+	struct st_susfs_sus_kstat_redirect entry;
+	struct susfs_sus_kstat_redirect_hl_node *node;
+	struct path path;
+	int err = 0;
+
+	if (copy_from_user(&entry, user_arg, sizeof(entry)))
+		return -EFAULT;
+
+	err = kern_path(entry.real_pathname, LOOKUP_FOLLOW, &path);
+	if (err) {
+		pr_err("susfs: failed to resolve real path: %s, err: %d\n", entry.real_pathname, err);
+		return err;
+	}
+
+	node = kmalloc(sizeof(*node), GFP_KERNEL);
+	if (!node) {
+		path_put(&path);
+		return -ENOMEM;
+	}
+
+	strncpy(node->virtual_pathname, entry.virtual_pathname, SUSFS_MAX_LEN_PATHNAME - 1);
+	node->virtual_pathname[SUSFS_MAX_LEN_PATHNAME - 1] = '\0';
+	node->target_ino = path.dentry->d_inode->i_ino;
+	memcpy(&node->info, &entry, sizeof(entry));
+
+	spin_lock(&susfs_kstat_redirect_lock);
+	hash_add_rcu(sus_kstat_redirect_hashtable, &node->node, node->target_ino);
+	spin_unlock(&susfs_kstat_redirect_lock);
+
+	path_put(&path);
+	return 0;
+}
+
+bool susfs_is_sus_kstat_redirect(struct dentry *dentry, struct kstat *stat)
+{
+	struct susfs_sus_kstat_redirect_hl_node *cursor;
+	unsigned long ino;
+
+	if (!dentry || !dentry->d_inode || !stat)
+		return false;
+
+	ino = dentry->d_inode->i_ino;
+	rcu_read_lock();
+	hash_for_each_possible_rcu(sus_kstat_redirect_hashtable, cursor, node, ino) {
+		if (cursor->target_ino == ino) {
+			stat->ino = cursor->info.spoofed_ino;
+			stat->dev = cursor->info.spoofed_dev;
+			stat->nlink = cursor->info.spoofed_nlink;
+			stat->size = cursor->info.spoofed_size;
+			stat->atime.tv_sec = cursor->info.spoofed_atime_tv_sec;
+			stat->atime.tv_nsec = cursor->info.spoofed_atime_tv_nsec;
+			stat->mtime.tv_sec = cursor->info.spoofed_mtime_tv_sec;
+			stat->mtime.tv_nsec = cursor->info.spoofed_mtime_tv_nsec;
+			stat->ctime.tv_sec = cursor->info.spoofed_ctime_tv_sec;
+			stat->ctime.tv_nsec = cursor->info.spoofed_ctime_tv_nsec;
+			stat->blksize = cursor->info.spoofed_blksize;
+			stat->blocks = cursor->info.spoofed_blocks;
+			rcu_read_unlock();
+			return true;
+		}
+	}
+	rcu_read_unlock();
+	return false;
+}
+#endif
